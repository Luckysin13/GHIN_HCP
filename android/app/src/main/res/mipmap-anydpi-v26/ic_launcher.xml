<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon, for API 26 and up.

  Anything below 26 keeps the mipmap PNGs, which is why the same artwork is
  generated in both forms: a device that only ever sees the legacy bitmap still
  gets the same ball and flag, just without being able to parallax them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons on Android 13 and up. Ignored by older versions. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
